# Host port published by Docker Compose. The process inside the container listens on 8080.
SERVER_PORT=8080

# Leave this as default unless application-prod.yml has been installed and PostgreSQL is reachable.
SPRING_PROFILES_ACTIVE=default

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom

# Used only with the production PostgreSQL profile. Do not commit real values.
# DATABASE_URL=jdbc:postgresql://db:5432/taskdb
# DATABASE_USERNAME=taskapi
# DATABASE_PASSWORD=
